#!/usr/bin/env grease
set -eu

case $0 in
  */*) script_directory=${0%/*} ;;
  *) script_directory=. ;;
esac
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)
. "$repository_root/lib/android_shizuku_host.grease"

ib_shizuku_usage() {
  printf 'usage: %s authority|identity|processes|run COMMAND|signal PID [SIGNAL]\n' "$0" >&2
}

subcommand=${1:-}
if test -z "$subcommand"; then
  ib_shizuku_usage
  exit 2
fi
shift

case "$subcommand" in
  authority)
    test "$#" -eq 0 || {
      ib_shizuku_usage
      exit 2
    }
    ib_shizuku_authority
    ;;
  identity)
    test "$#" -eq 0 || {
      ib_shizuku_usage
      exit 2
    }
    ib_shizuku_identity
    ;;
  processes)
    test "$#" -eq 0 || {
      ib_shizuku_usage
      exit 2
    }
    ib_shizuku_process_snapshot
    ;;
  package-pids)
    test "$#" -eq 1 || {
      ib_shizuku_usage
      exit 2
    }
    ib_shizuku_package_pids "$1"
    ;;
  force-stop)
    test "$#" -eq 1 || {
      ib_shizuku_usage
      exit 2
    }
    ib_shizuku_force_stop_package "$1"
    ;;
  run)
    test "$#" -eq 1 || {
      ib_shizuku_usage
      exit 2
    }
    ib_shizuku_run "$1"
    ;;
  process-identity)
    test "$#" -eq 1 || {
      ib_shizuku_usage
      exit 2
    }
    ib_shizuku_process_identity "$1"
    ;;
  signal-owned)
    if test "$#" -eq 3; then
      ib_shizuku_signal_owned "$1" "$2" "$3"
    elif test "$#" -eq 4; then
      ib_shizuku_signal_owned "$1" "$2" "$3" "$4"
    else
      ib_shizuku_usage
      exit 2
    fi
    ;;
  *)
    ib_shizuku_usage
    exit 2
    ;;
esac
