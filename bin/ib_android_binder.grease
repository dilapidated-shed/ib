#!/usr/bin/env grease
set -eu

case $0 in
  */*) script_directory=${0%/*} ;;
  *) script_directory=. ;;
esac
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)

# Platform assembly: Binder is the public IB boundary; Shizuku is the current
# provider underneath it.
. "$repository_root/lib/android_shizuku_host.grease"
. "$repository_root/lib/android_binder_host.grease"

usage() {
  printf 'usage: %s provider|authority|identity|processes|process-identity PID|package-pids PACKAGE|signal-owned PID START NAME [SIGNAL]|force-stop PACKAGE\n' "$0" >&2
}

command=${1:-}
test -n "$command" || {
  usage
  exit 2
}
shift

case "$command" in
  provider)
    test "$#" -eq 0 || { usage; exit 2; }
    ib_binder_provider
    ;;
  authority)
    test "$#" -eq 0 || { usage; exit 2; }
    ib_binder_authority
    ;;
  identity)
    test "$#" -eq 0 || { usage; exit 2; }
    ib_binder_identity
    ;;
  processes)
    test "$#" -eq 0 || { usage; exit 2; }
    ib_binder_process_snapshot
    ;;
  process-identity)
    test "$#" -eq 1 || { usage; exit 2; }
    ib_binder_process_identity "$1"
    ;;
  package-pids)
    test "$#" -eq 1 || { usage; exit 2; }
    ib_binder_package_pids "$1"
    ;;
  signal-owned)
    if test "$#" -eq 3; then
      ib_binder_signal_owned "$1" "$2" "$3"
    elif test "$#" -eq 4; then
      ib_binder_signal_owned "$1" "$2" "$3" "$4"
    else
      usage
      exit 2
    fi
    ;;
  force-stop)
    test "$#" -eq 1 || { usage; exit 2; }
    ib_binder_force_stop_package "$1"
    ;;
  *)
    usage
    exit 2
    ;;
esac
