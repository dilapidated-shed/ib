#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
idric_prefix=${IDRIC_PREFIX:-/tmp/idric}
idric_ref=${IDRIC_REF:-bd9fbe1e68ce9b3dd3981fcd3e1abf9e50bd350e}
pdf_harvester_ref=${PDF_HARVESTER_REF:-77d85dc6f7e89d109cb9e06f42706bc34f00e4a3}
aici_ref=${AICI_REF:-c1e423d506f6adfc8c1c9659a4faaf94ae84eaf0}

install_dependencies() {
  sudo apt-get update
  sudo apt-get install -y chezscheme curl xmlstarlet busybox poppler-utils
}

build_idric() {
  rm -rf /tmp/Idric "$idric_prefix"
  git init -q /tmp/Idric
  git -C /tmp/Idric remote add origin https://github.com/isomorphisms/Idric.git
  git -C /tmp/Idric fetch --depth 1 origin "$idric_ref"
  git -C /tmp/Idric checkout --detach -q FETCH_HEAD
  test "$(git -C /tmp/Idric rev-parse HEAD)" = "$idric_ref"
  # The maintained Chez path needs the common C support library, not the
  # optional RefC/GMP support built by the aggregate support targets.
  make -C /tmp/Idric/_/support/c
  sh /tmp/Idric/_/edric scheme >/dev/null
  PATH="/tmp/Idric/_/.tools/bin:$PATH" \
    SCHEME=/tmp/Idric/_/.tools/bin/scheme \
    CHEZ=/tmp/Idric/_/.tools/bin/scheme \
    make -C /tmp/Idric/_ \
      bootstrap MAKE="$repository_root/bin/idric-chez-make"

  mkdir -p "$idric_prefix/bin"
  cp -a /tmp/Idric/_/.tools "$idric_prefix/.tools"
  cp -a /tmp/Idric/_/bootstrap-build "$idric_prefix/bootstrap-build"
  cp -a /tmp/Idric/_/build "$idric_prefix/build"
  {
    printf '%s\n' '#!/bin/sh' 'set -eu'
    printf '%s\n' 'prefix=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)'
    printf '%s\n' 'IDRIS2_PREFIX="$prefix/bootstrap-build"'
    printf '%s\n' 'CHEZ="$prefix/.tools/bin/scheme"'
    printf '%s\n' 'app="$prefix/build/exec/idris2_app"'
    printf '%s\n' 'LD_LIBRARY_PATH="$app${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"'
    printf '%s\n' 'DYLD_LIBRARY_PATH="$app${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"'
    printf '%s\n' 'IDRIS2_INC_SRC="$app"'
    printf '%s\n' 'export IDRIS2_PREFIX CHEZ LD_LIBRARY_PATH DYLD_LIBRARY_PATH IDRIS2_INC_SRC'
    printf '%s\n' 'exec "$CHEZ" --program "$app/idris2.so" "$@"'
  } >"$idric_prefix/bin/idris2"
  chmod +x "$idric_prefix/bin/idris2"

  # Prove that neither the source tree nor the original prefix is required by
  # the cached compiler. The cache is restored in a different runner process.
  source_hold=/tmp/Idric.build-source
  relocated_prefix="${idric_prefix}.relocated"
  rm -rf "$source_hold" "$relocated_prefix"
  mv /tmp/Idric "$source_hold"
  mv "$idric_prefix" "$relocated_prefix"
  "$relocated_prefix/bin/idris2" --version
  mv "$relocated_prefix" "$idric_prefix"
  rm -rf "$source_hold"
}

verify_pdf_harvester() {
  test -d "$repository_root/vendor/harvest-images-from-pdf/.git" ||
    test -f "$repository_root/vendor/harvest-images-from-pdf/.git"
  test "$(git -C "$repository_root/vendor/harvest-images-from-pdf" rev-parse HEAD)" = "$pdf_harvester_ref"
  test -f "$repository_root/vendor/harvest-images-from-pdf/src/PDF/Parser.idric"
  test -f "$repository_root/vendor/harvest-images-from-pdf/src/PDF/Figure.idric"
}

exercise_core() {
  cd "$repository_root/src"
  "$idric_prefix/bin/idris2" Smoke.idric -o ib-smoke 2>&1 | tee /tmp/idric-compile.txt
  test -x ./build/exec/ib-smoke
  ! grep -q '^Error:' /tmp/idric-compile.txt
  ./build/exec/ib-smoke | tee /tmp/ib-smoke.txt
  grep -Fx 'ingest=3' /tmp/ib-smoke.txt
  grep -Fx 'duplicate-url-count=2' /tmp/ib-smoke.txt
  grep -Fx 'newest-order=2' /tmp/ib-smoke.txt
  grep -Fx 'host-count=2' /tmp/ib-smoke.txt
  grep -Fx 'canonical=canonical' /tmp/ib-smoke.txt
  grep -Fx 'cache-fake=cache' /tmp/ib-smoke.txt
  grep -Fx 'secret=secret' /tmp/ib-smoke.txt
  grep -Fx 'readable-files=2' /tmp/ib-smoke.txt
  grep -Fx 'canonical-files=2' /tmp/ib-smoke.txt
  grep -Fx 'copy-label=Copy' /tmp/ib-smoke.txt
  grep -Fx 'copy-target=code-1' /tmp/ib-smoke.txt
  grep -Fx 'copy-payload=git status' /tmp/ib-smoke.txt
  grep -Fx 'arxiv-html-first=https://arxiv.org/html/2203.11355' /tmp/ib-smoke.txt
  grep -Fx 'arxiv-prefetch=all-html-figures' /tmp/ib-smoke.txt
  grep -Fx 'caption-name-basis=caption' /tmp/ib-smoke.txt
  grep -Fx 'temporary-needs-language-model=True' /tmp/ib-smoke.txt
  grep -Fx 'prefetch-bounded=2' /tmp/ib-smoke.txt
  grep -Fx 'prefetch-reading=1' /tmp/ib-smoke.txt

  "$idric_prefix/bin/idris2" OccurrenceSmoke.idric -o ib-occurrence-smoke \
    2>&1 | tee /tmp/idric-occurrence-compile.txt
  test -x ./build/exec/ib-occurrence-smoke
  ! grep -q '^Error:' /tmp/idric-occurrence-compile.txt
  ./build/exec/ib-occurrence-smoke | tee /tmp/ib-occurrence-smoke.txt
  cmp "$repository_root/tests/fixtures/occurrence-smoke.expected" \
    /tmp/ib-occurrence-smoke.txt

  "$idric_prefix/bin/idris2" PaintBudgetSmoke.idric -o ib-paint-budget-smoke \
    2>&1 | tee /tmp/idric-paint-budget-compile.txt
  test -x ./build/exec/ib-paint-budget-smoke
  ! grep -q '^Error:' /tmp/idric-paint-budget-compile.txt
  ./build/exec/ib-paint-budget-smoke | tee /tmp/ib-paint-budget-smoke.txt
  grep -Fx 'paint-budget-cheap-full=True' /tmp/ib-paint-budget-smoke.txt
  grep -Fx 'paint-budget-expensive-reduced=True' /tmp/ib-paint-budget-smoke.txt
  grep -Fx 'paint-budget-pathological-reused=True' /tmp/ib-paint-budget-smoke.txt
  grep -Fx 'paint-budget-pathological-deferred=True' /tmp/ib-paint-budget-smoke.txt
}

exercise_workbench() {
  cd "$repository_root"
  sh -n tests/test_real_world_url_fixture.grease
  sh tests/test_real_world_url_fixture.grease

  cd "$repository_root/src"
  "$idric_prefix/bin/idris2" Workbench.idric -o ib-workbench 2>&1 | tee /tmp/idric-workbench-compile.txt
  test -x ./build/exec/ib-workbench
  ! grep -q '^Error:' /tmp/idric-workbench-compile.txt
  ./build/exec/ib-workbench | tee /tmp/ib-workbench.txt
  grep -Fx 'fixture-urls=10000' /tmp/ib-workbench.txt
  grep -Fx 'fixture-42=ib://fixture/42' /tmp/ib-workbench.txt
  grep -Fx 'logical-tabs=32' /tmp/ib-workbench.txt
  grep -Fx 'churn-steps=10000' /tmp/ib-workbench.txt
  grep -Fx 'resident-at-3=3' /tmp/ib-workbench.txt
  grep -Fx 'resident-at-10=10' /tmp/ib-workbench.txt
}

build_information_programs() {
  test -x "$idric_prefix/bin/idris2" || build_idric
  cd "$repository_root/src"
  "$idric_prefix/bin/idris2" InformationSmoke.idric -o ib-information-smoke \
    2>&1 | tee /tmp/idric-information-compile.txt
  test -x ./build/exec/ib-information-smoke
  ! grep -q '^Error:' /tmp/idric-information-compile.txt
  "$idric_prefix/bin/idris2" ArxivPrepaint.idric -o ib-arxiv-prepaint \
    2>&1 | tee /tmp/idric-arxiv-prepaint-compile.txt
  test -x ./build/exec/ib-arxiv-prepaint
  ! grep -q '^Error:' /tmp/idric-arxiv-prepaint-compile.txt
}

exercise_information() {
  build_information_programs
  cd "$repository_root"
  src/build/exec/ib-information-smoke | tee /tmp/ib-information-smoke.txt
  grep -Fx 'information-title=Build console' /tmp/ib-information-smoke.txt
  grep -Fx 'early-table-header=True' /tmp/ib-information-smoke.txt
  grep -Fx 'early-table-data=True' /tmp/ib-information-smoke.txt
  grep -Fx 'full-link=True' /tmp/ib-information-smoke.txt
  grep -Fx 'full-form=True' /tmp/ib-information-smoke.txt
  grep -Fx 'script-leaked=False' /tmp/ib-information-smoke.txt
  grep -Fx 'style-leaked=False' /tmp/ib-information-smoke.txt
  grep -Fx 'video-leaked=False' /tmp/ib-information-smoke.txt
  grep -Fx 'html-must-escalate=False' /tmp/ib-information-smoke.txt
  grep -Fx 'shell-must-escalate=True' /tmp/ib-information-smoke.txt
  grep -Fx 'phone-api-row=True' /tmp/ib-information-smoke.txt
  grep -Fx 'phone-lines=8' /tmp/ib-information-smoke.txt
  grep -Fx 'phone-width-bounded=True' /tmp/ib-information-smoke.txt
  sh -n bin/prepaint_arxiv_progressively.grease
  sh -n tests/test_arxiv_progressive_prepaint.grease
  sh tests/test_arxiv_progressive_prepaint.grease
}

exercise_hostile_ingestion() {
  aici_root="$repository_root/.tools/ai-ci"
  test -d "$aici_root/.git"
  test "$(git -C "$aici_root" rev-parse HEAD)" = "$aici_ref"
  (cd "$aici_root/ingestion/corpus-v1" && sha256sum -c CORPUS.sha256)
  cc -std=c17 -Wall -Wextra -Werror -pedantic -O2 \
    -o /tmp/aici-ingestion "$aici_root/ingestion/src/aici_ingestion.c"

  cd "$repository_root/src"
  "$idric_prefix/bin/idris2" HostileIngestionReceipt.idric \
    -o ib-hostile-ingestion 2>&1 | tee /tmp/idric-hostile-ingestion-compile.txt
  test -x build/exec/ib-hostile-ingestion
  ! grep -q '^Error:' /tmp/idric-hostile-ingestion-compile.txt

  implementation_revision=$(git -C "$repository_root" rev-parse HEAD)
  executable_sha256=$(sha256sum \
    build/exec/ib-hostile-ingestion_app/ib-hostile-ingestion.so | cut -d ' ' -f1)
  corpus_root="$aici_root/ingestion/corpus-v1"

  build/exec/ib-hostile-ingestion \
    valid_utf8 "$corpus_root/bodies/valid.html" \
    'Hostile fixture' 'reading list' /reading \
    "$aici_ref" "$implementation_revision" "$executable_sha256" \
    >/tmp/ib-valid-ingestion.receipt.tsv

  build/exec/ib-hostile-ingestion \
    malformed_html "$corpus_root/bodies/malformed.html" \
    'Recovered fixture' syllabus /syllabus \
    "$aici_ref" "$implementation_revision" "$executable_sha256" \
    >/tmp/ib-malformed-ingestion.receipt.tsv

  /tmp/aici-ingestion verify "$corpus_root" \
    /tmp/ib-valid-ingestion.receipt.tsv consumer -
  /tmp/aici-ingestion verify "$corpus_root" \
    /tmp/ib-malformed-ingestion.receipt.tsv consumer -
  grep -Fx "$(printf 'summary\tfirst_failure\tnone')" /tmp/ib-valid-ingestion.receipt.tsv
  grep -Fx "$(printf 'summary\tfirst_failure\tnone')" /tmp/ib-malformed-ingestion.receipt.tsv
  grep -F 'document_log_subset_v0' /tmp/ib-malformed-ingestion.receipt.tsv
  grep -F 'expected_link_extracted' /tmp/ib-malformed-ingestion.receipt.tsv
}


exercise_scientific_media() {
  cd "$repository_root"
  sh -n lib/scientific_media.grease
  sh -n lib/pdf_figure_captions.grease
  sh -n lib/prefetch.grease
  sh -n lib/scientific_prefetch.grease
  sh -n lib/scientific_navigation_prefetch.grease
  sh -n bin/harvest_arxiv_images.grease
  sh -n bin/build_pdf_caption_associator.grease
  sh -n bin/rename_harvested_images_with_llm.grease
  sh -n bin/prefetch_arxiv_reading.grease
  sh -n bin/navigation_committed.grease
  sh -n tests/test_scientific_image_harvest.grease
  sh -n tests/test_prefetch_reading.grease
  sh -n tests/test_scientific_navigation_prefetch.grease
  sh bin/build_pdf_caption_associator.grease
  printf '%s\n' 'scientific-media: image harvest regression'
  sh tests/test_scientific_image_harvest.grease
  printf '%s\n' 'scientific-media: reading prefetch regression'
  sh tests/test_prefetch_reading.grease
  printf '%s\n' 'scientific-media: navigation prefetch regression'
  timeout 30 sh tests/test_scientific_navigation_prefetch.grease
}

exercise_live_arxiv() {
  cd "$repository_root"
  sh -n tests/live_arxiv_image_harvest.grease
  sh tests/live_arxiv_image_harvest.grease
}

exercise_live_arxiv_prepaint() {
  build_information_programs
  cd "$repository_root"
  sh -n tests/live_arxiv_progressive_prepaint.grease
  sh tests/live_arxiv_progressive_prepaint.grease
}

case "${1:-}" in
  install-dependencies) install_dependencies ;;
  build-idric) build_idric ;;
  verify-pdf-harvester) verify_pdf_harvester ;;
  exercise-information) exercise_information ;;
  exercise-hostile-ingestion) exercise_hostile_ingestion ;;
  exercise-core) exercise_core ;;
  exercise-workbench) exercise_workbench ;;
  exercise-scientific-media) exercise_scientific_media ;;
  exercise-live-arxiv) exercise_live_arxiv ;;
  exercise-live-arxiv-prepaint) exercise_live_arxiv_prepaint ;;
  *)
    printf 'usage: %s {install-dependencies|build-idric|verify-pdf-harvester|exercise-information|exercise-hostile-ingestion|exercise-core|exercise-workbench|exercise-scientific-media|exercise-live-arxiv|exercise-live-arxiv-prepaint}\n' "$0" >&2
    exit 2
    ;;
esac
