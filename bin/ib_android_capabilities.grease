#!/usr/bin/env grease
set -eu

case $0 in
  */*) script_directory=${0%/*} ;;
  *) script_directory=. ;;
esac
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)
. "$repository_root/lib/android_shizuku_host.grease"
. "$repository_root/lib/android_device_capabilities.grease"

if command -v git >/dev/null 2>&1; then
  IB_CAPABILITY_SOURCE_HEAD=$(git -C "$repository_root" rev-parse HEAD 2>/dev/null || true)
  export IB_CAPABILITY_SOURCE_HEAD
fi

case ${1:-report} in
  report)
    test "$#" -le 1 || exit 2
    ib_android_capabilities_report
    ;;
  summary)
    test "$#" -le 1 || exit 2
    ib_android_capabilities_report | ib_android_capabilities_summary
    ;;
  app)
    test "$#" -le 1 || exit 2
    ib_android_capabilities_open_app_report
    ;;
  *)
    printf 'usage: %s [report|summary|app]\n' "$0" >&2
    exit 2
    ;;
esac
