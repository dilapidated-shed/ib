# Grease/POSIX-shell adapter for the first bounded Longview worker experiment.
# This worker is deliberately non-sensitive and deterministic. It uses a fixed
# shell-owned fixture root; it is not a WebView host and it never receives page,
# model, downloaded-script, or arbitrary command text.

ib_longview_worker_validate_atom() {
  if test "$#" -ne 1; then
    return 2
  fi
  case "$1" in
    ''|.|..|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*)
      return 2
      ;;
  esac
}

ib_longview_worker_start() {
  if test "$#" -ne 3; then
    printf '%s\n' 'ib_longview_worker_start expects WORK_ID RESULT_ID immediate|delayed' >&2
    return 2
  fi

  work_id=$1
  result_id=$2
  mode=$3
  ib_longview_worker_validate_atom "$work_id" || return 2
  ib_longview_worker_validate_atom "$result_id" || return 2

  case "$mode" in
    immediate) delay=0 ;;
    delayed) delay=30 ;;
    *)
      printf 'invalid worker mode: %s\n' "$mode" >&2
      return 2
      ;;
  esac

  # All interpolated values above are restricted atoms or one selected numeric
  # literal. The worker program itself is fixed, reviewed command text.
  command_text="# IB_LONGVIEW_WORKER_START_V1
set -eu
root=/data/local/tmp/ib-longview-fixture-v1
backend=android-shizuku-shell-v1
work=$work_id
result=$result_id
delay=$delay
umask 077
mkdir -p \"\$root/.ib-staging\" \"\$root/objects\" \"\$root/work\"
marker=\"\$root/.ib-backend-id\"
if test -f \"\$marker\"; then
  test \"\$(cat \"\$marker\")\" = \"\$backend\" || exit 67
else
  printf '%s\\n' \"\$backend\" >\"\$marker.tmp.\$\$\"
  sync
  mv \"\$marker.tmp.\$\$\" \"\$marker\"
  sync
fi
status=\"\$root/work/\$work.status\"
printf 'running\\n' >\"\$status\"
(
  trap '' HUP
  if test \"\$delay\" -gt 0; then sleep \"\$delay\"; fi
  tmp=\"\$root/.ib-staging/\$result.\$\$.tmp\"
  final=\"\$root/objects/\$result\"
  {
    printf 'schema\\tib-longview-worker-result-v1\\n'
    printf 'work_id\\t%s\\n' \"\$work\"
    printf 'result_id\\t%s\\n' \"\$result\"
    printf 'value\\tdeterministic-ok\\n'
  } >\"\$tmp\"
  bytes=\$(wc -c <\"\$tmp\" | tr -d '[:space:]')
  test \"\$bytes\" -le 256 || {
    rm -f \"\$tmp\"
    printf 'failed:result-limit\\n' >\"\$status\"
    exit 69
  }
  if test -e \"\$final\"; then
    if cmp -s \"\$tmp\" \"\$final\"; then
      rm -f \"\$tmp\"
    else
      rm -f \"\$tmp\"
      printf 'failed:object-conflict\\n' >\"\$status\"
      exit 70
    fi
  else
    sync
    mv \"\$tmp\" \"\$final\"
    sync
  fi
  printf 'committed\\n' >\"\$status\"
) </dev/null >/dev/null 2>&1 &
pid=\$!
stat=/proc/\$pid/stat
comm=/proc/\$pid/comm
test -r \"\$stat\" && test -r \"\$comm\" || exit 44
tail=\$(sed 's/^[0-9][0-9]* (.*) //' \"\$stat\") || exit 44
start=\$(printf '%s\\n' \"\$tail\" | awk '{print \$20}')
name=\$(tr -d '\\r\\n' <\"\$comm\")
test -n \"\$start\" && test -n \"\$name\" || exit 44
printf 'worker\\t%s\\t%s\\t%s\\n' \"\$pid\" \"\$start\" \"\$name\""

  ib_shizuku_run_bounded 5 "$command_text"
}

ib_longview_worker_status() {
  if test "$#" -ne 1; then
    printf '%s\n' 'ib_longview_worker_status expects WORK_ID' >&2
    return 2
  fi
  work_id=$1
  ib_longview_worker_validate_atom "$work_id" || return 2

  command_text="# IB_LONGVIEW_WORKER_STATUS_V1
set -eu
root=/data/local/tmp/ib-longview-fixture-v1
backend=android-shizuku-shell-v1
work=$work_id
marker=\"\$root/.ib-backend-id\"
test -f \"\$marker\" || exit 67
test \"\$(cat \"\$marker\")\" = \"\$backend\" || exit 67
status=\"\$root/work/\$work.status\"
test -f \"\$status\" || exit 68
bytes=\$(wc -c <\"\$status\" | tr -d '[:space:]')
test \"\$bytes\" -le 64 || exit 69
cat \"\$status\""
  ib_shizuku_run_bounded 5 "$command_text"
}

ib_longview_worker_read_result() {
  if test "$#" -ne 1; then
    printf '%s\n' 'ib_longview_worker_read_result expects RESULT_ID' >&2
    return 2
  fi
  result_id=$1
  ib_longview_worker_validate_atom "$result_id" || return 2

  command_text="# IB_LONGVIEW_WORKER_READ_V1
set -eu
root=/data/local/tmp/ib-longview-fixture-v1
backend=android-shizuku-shell-v1
result=$result_id
marker=\"\$root/.ib-backend-id\"
test -f \"\$marker\" || exit 67
test \"\$(cat \"\$marker\")\" = \"\$backend\" || exit 67
final=\"\$root/objects/\$result\"
test -f \"\$final\" || exit 68
bytes=\$(wc -c <\"\$final\" | tr -d '[:space:]')
test \"\$bytes\" -le 256 || exit 69
cat \"\$final\""
  ib_shizuku_run_bounded 5 "$command_text"
}
