# Binder-facing Longview worker adapter.
#
# Longview owns durable work/result identity and validates caller-controlled
# atoms. Android execution is supplied by the Binder boundary. The current
# Binder provider is Shizuku, but no Shizuku/rish/shell command belongs here.

ib_longview_worker_validate_atom() {
  if test "$#" -ne 1; then
    return 2
  fi
  case "$1" in
    ''|.|..|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*)
      return 2
      ;;
  esac
}

ib_longview_worker_start() {
  if test "$#" -ne 3; then
    printf '%s\n' 'ib_longview_worker_start expects WORK_ID RESULT_ID immediate|delayed' >&2
    return 2
  fi
  ib_longview_worker_validate_atom "$1" || return 2
  ib_longview_worker_validate_atom "$2" || return 2
  case "$3" in
    immediate|delayed) ;;
    *)
      printf 'invalid worker mode: %s\n' "$3" >&2
      return 2
      ;;
  esac
  ib_binder_worker_start "$1" "$2" "$3"
}

ib_longview_worker_status() {
  if test "$#" -ne 1; then
    printf '%s\n' 'ib_longview_worker_status expects WORK_ID' >&2
    return 2
  fi
  ib_longview_worker_validate_atom "$1" || return 2
  ib_binder_worker_status "$1"
}

ib_longview_worker_read_result() {
  if test "$#" -ne 1; then
    printf '%s\n' 'ib_longview_worker_read_result expects RESULT_ID' >&2
    return 2
  fi
  ib_longview_worker_validate_atom "$1" || return 2
  ib_binder_worker_read_result "$1"
}

ib_longview_worker_observe() {
  if test "$#" -ne 5; then
    printf '%s\n' 'ib_longview_worker_observe expects WORK_ID RESULT_ID PID START_TICKS PROCESS_NAME' >&2
    return 2
  fi

  ib_longview_worker_validate_atom "$1" || return 2
  ib_longview_worker_validate_atom "$2" || return 2
  ib_binder_validate_pid "$3" || return 2
  ib_binder_validate_start_ticks "$4" || return 2
  ib_binder_validate_process_name "$5" || return 2

  ib_binder_worker_observe "$1" "$2" "$3" "$4" "$5"
}
