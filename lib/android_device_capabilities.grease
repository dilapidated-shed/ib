# Grease/POSIX-shell source. Read-only Android capability observation for IB.
# Browser policy consumes these observations; this adapter does not choose storage.

ib_capabilities_emit() {
  if test "$#" -ne 5; then
    printf '%s\n' 'ib_capabilities_emit expects KIND NAME STATUS AUTHORITY VALUE' >&2
    return 2
  fi
  kind=$1
  name=$2
  status=$3
  authority=$4
  value=$5
  clean_value=$(printf '%s' "$value" | tr '\t\r\n' '   ')
  printf '%s\t%s\t%s\t%s\t%s\n' "$kind" "$name" "$status" "$authority" "$clean_value"
}

ib_capabilities_catfood_state() {
  state_home=${CATFOOD_STATE_HOME:-${XDG_STATE_HOME:-"$HOME/.local/state"}/catfood}
  state_dir=${CATFOOD_SHIZUKU_STATE_DIR:-"$state_home/shizuku"}

  ib_capabilities_emit field catfood_state_dir reported local "$state_dir"

  if test -n "${IB_DEVICE_LABEL:-}"; then
    ib_capabilities_emit field device_label reported local-config "$IB_DEVICE_LABEL"
  else
    ib_capabilities_emit field device_label unknown catfood 'no device label supplied by current Cat Food contract'
  fi

  # Cat Food #65 is still the place for a general per-device/local-checkout
  # manifest. Do not fabricate one from a directory name.
  ib_capabilities_emit field catfood_device_manifest unknown catfood 'general per-device manifest not available to this adapter'

  if ! test -f "$state_dir/current"; then
    ib_capabilities_emit field catfood_shizuku_snapshot unknown catfood 'no preserved Shizuku snapshot recorded'
    return 0
  fi

  snapshot_id=$(cat "$state_dir/current" 2>/dev/null || true)
  case "$snapshot_id" in
    ''|*/*|*..*)
      ib_capabilities_emit field catfood_shizuku_snapshot invalid catfood "$snapshot_id"
      return 0
      ;;
  esac

  snapshot=$state_dir/snapshots/$snapshot_id
  receipt=$snapshot/receipt.tsv
  if ! test -f "$receipt"; then
    ib_capabilities_emit field catfood_shizuku_snapshot stale catfood "$snapshot_id receipt-missing"
    return 0
  fi

  ib_capabilities_emit field catfood_shizuku_snapshot reported catfood "$snapshot_id"
  tab=$(printf '\t')
  while IFS="$tab" read -r key value rest; do
    test -z "${rest:-}" || value="$value $rest"
    case "$key" in
      manager_package|source_dir|rish_sha256|dex_sha256|schema|scope)
        ib_capabilities_emit field "catfood_$key" reported catfood "$value"
        ;;
    esac
  done < "$receipt"
}

ib_android_capabilities_open_app_report() {
  ib_binder_capabilities_open_app_report
}

ib_android_capabilities_report() {
  printf 'schema\tib-android-capabilities-v1\n'
  if test -n "${IB_CAPABILITY_SOURCE_HEAD:-}"; then
    ib_capabilities_emit field source_head reported local-checkout "$IB_CAPABILITY_SOURCE_HEAD"
  else
    ib_capabilities_emit field source_head unknown local-checkout unavailable
  fi
  ib_capabilities_catfood_state

  if test "${IB_SIMULATE_APPENDFAT:-0}" = 1; then
    ib_capabilities_emit field appendfat_simulation simulated local enabled
  else
    ib_capabilities_emit field appendfat_simulation reported local disabled
  fi

  if remote_output=$(ib_binder_capabilities_remote_snapshot 2>&1); then
    printf '%s\n' "$remote_output"
  else
    status=$?
    ib_capabilities_emit field binder_snapshot failed local "exit=$status $remote_output"
    return "$status"
  fi
}

ib_android_capabilities_summary() {
  tab=$(printf '\t')
  while IFS="$tab" read -r kind name status authority value; do
    case "$kind:$name" in
      schema:*) printf 'schema: %s\n' "$name" ;;
      field:device_label) printf 'device label: %s (%s, %s)\n' "$value" "$status" "$authority" ;;
      field:product_model) printf 'model: %s\n' "$value" ;;
      field:android_release) printf 'Android: %s\n' "$value" ;;
      field:android_sdk) printf 'SDK: %s\n' "$value" ;;
      field:remote_uid) printf 'Shizuku UID: %s\n' "$value" ;;
      field:catfood_shizuku_snapshot) printf 'Cat Food Shizuku snapshot: %s (%s)\n' "$value" "$status" ;;
      field:storage_profile) printf 'storage profile: %s (%s)\n' "$value" "$status" ;;
      field:bulk_candidate_mount) printf 'bulk candidate: %s (%s)\n' "$value" "$status" ;;
      field:bulk_candidate_total_kib) printf 'bulk total KiB: %s\n' "$value" ;;
      field:bulk_candidate_available_kib) printf 'bulk available KiB: %s\n' "$value" ;;
      field:ib_app_writer_access) printf 'IB app writer access: %s (%s)\n' "$value" "$status" ;;
      field:appendfat_status) printf 'appendfat observed: %s (%s)\n' "$value" "$status" ;;
      field:capacity_pool_relationship) printf 'capacity-pool relation: %s\n' "$value" ;;
      storage_df:row) printf 'storage: %s\n' "$value" ;;
      storage_volume:row) printf 'Android volume: %s\n' "$value" ;;
      memory:row) printf 'memory: %s\n' "$value" ;;
    esac
  done
}
