#!/usr/bin/env grease
set -eu

case $0 in
  */*) script_directory=${0%/*} ;;
  *) script_directory=. ;;
esac
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)

# Stub the current provider at its narrow edge. This test proves that callers
# bind to ib_binder_* rather than to Shizuku names.
ib_shizuku_authority() { printf '%s\n' 'shell'; }
ib_shizuku_identity() { printf '%s\n' 'identity-via-provider'; }
ib_shizuku_process_snapshot() { printf '%s\n' 'processes-via-provider'; }
ib_shizuku_validate_pid() { test "$1" = 123; }
ib_shizuku_validate_start_ticks() { test "$1" = 999; }
ib_shizuku_validate_process_name() { test "$1" = worker; }
ib_shizuku_process_identity() { test "$1" = 123; printf '123\t999\tworker\n'; }
ib_shizuku_signal_owned() {
  test "$1" = 123
  test "$2" = 999
  test "$3" = worker
  test "${4:-TERM}" = TERM
}
ib_shizuku_package_pids() { test "$1" = org.isomorphisms.ib; printf '%s\n' 4242; }
ib_shizuku_force_stop_package() { test "$1" = org.isomorphisms.ib; }
ib_shizuku_worker_start() {
  test "$1" = work-1
  test "$2" = result-1
  test "$3" = immediate
  printf 'worker\t123\t999\tworker\n'
}
ib_shizuku_worker_status() { test "$1" = work-1; printf '%s\n' committed; }
ib_shizuku_worker_read_result() { test "$1" = result-1; printf '%s\n' result-via-provider; }
ib_shizuku_worker_observe() {
  test "$1" = work-1
  test "$2" = result-1
  test "$3" = 123
  test "$4" = 999
  test "$5" = worker
  printf '%s\n' committed
}
ib_shizuku_capabilities_remote_snapshot() { printf '%s\n' capability-via-provider; }
ib_shizuku_capabilities_open_app_report() { printf '%s\n' app-report-via-provider; }

. "$repository_root/lib/android_binder_host.grease"

test "$(ib_binder_provider)" = shizuku
test "$(ib_binder_authority)" = shell
test "$(ib_binder_identity)" = identity-via-provider
test "$(ib_binder_process_snapshot)" = processes-via-provider
ib_binder_validate_pid 123
ib_binder_validate_start_ticks 999
ib_binder_validate_process_name worker
test "$(ib_binder_process_identity 123)" = "$(printf '123\t999\tworker')"
ib_binder_signal_owned 123 999 worker TERM
test "$(ib_binder_package_pids org.isomorphisms.ib)" = 4242
ib_binder_force_stop_package org.isomorphisms.ib
test "$(ib_binder_worker_start work-1 result-1 immediate)" = "$(printf 'worker\t123\t999\tworker')"
test "$(ib_binder_worker_status work-1)" = committed
test "$(ib_binder_worker_read_result result-1)" = result-via-provider
test "$(ib_binder_worker_observe work-1 result-1 123 999 worker)" = committed
test "$(ib_binder_capabilities_remote_snapshot)" = capability-via-provider
test "$(ib_binder_capabilities_open_app_report)" = app-report-via-provider

for generic in \
  lib/android_longview_worker.grease \
  lib/android_device_capabilities.grease \
  bin/ib_android_longview_worker.grease \
  bin/accept_android_longview_worker.grease \
  bin/ib_android_capabilities.grease
do
  if grep -n 'ib_shizuku_' "$repository_root/$generic" >/dev/null; then
    printf 'generic Binder-facing file calls Shizuku directly: %s\n' "$generic" >&2
    exit 1
  fi
done

printf '%s\n' 'android Binder host boundary tests: ok'
