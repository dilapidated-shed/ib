#!/usr/bin/env grease
set -eu

case $0 in
  */*) script_directory=${0%/*} ;;
  *) script_directory=. ;;
esac
repository_root=$(CDPATH= cd -- "$script_directory/.." && pwd)

# Stub the current provider at its narrow edge. This test proves that callers
# bind to ib_binder_* rather than to Shizuku names.
ib_shizuku_run() {
  test "$1" = '__binder-test__'
  printf '%s\n' 'provider-run'
}
ib_shizuku_run_bounded() {
  test "$1" = 5
  test "$2" = '__binder-test__'
  printf '%s\n' 'provider-bounded'
}
ib_shizuku_authority() { printf '%s\n' 'shell'; }
ib_shizuku_identity() { printf '%s\n' 'identity-via-provider'; }
ib_shizuku_process_snapshot() { printf '%s\n' 'processes-via-provider'; }
ib_shizuku_validate_pid() { test "$1" = 123; }
ib_shizuku_validate_start_ticks() { test "$1" = 999; }
ib_shizuku_validate_process_name() { test "$1" = worker; }
ib_shizuku_process_identity() { test "$1" = 123; printf '123\t999\tworker\n'; }
ib_shizuku_signal_owned() {
  test "$1" = 123
  test "$2" = 999
  test "$3" = worker
  test "${4:-TERM}" = TERM
}
ib_shizuku_package_pids() { test "$1" = org.isomorphisms.ib; printf '%s\n' 4242; }
ib_shizuku_force_stop_package() { test "$1" = org.isomorphisms.ib; }

. "$repository_root/lib/android_binder_host.grease"

test "$(ib_binder_provider)" = shizuku
test "$(ib_binder_run '__binder-test__')" = provider-run
test "$(ib_binder_run_bounded 5 '__binder-test__')" = provider-bounded
test "$(ib_binder_authority)" = shell
test "$(ib_binder_identity)" = identity-via-provider
test "$(ib_binder_process_snapshot)" = processes-via-provider
ib_binder_validate_pid 123
ib_binder_validate_start_ticks 999
ib_binder_validate_process_name worker
test "$(ib_binder_process_identity 123)" = "$(printf '123\t999\tworker')"
ib_binder_signal_owned 123 999 worker TERM
test "$(ib_binder_package_pids org.isomorphisms.ib)" = 4242
ib_binder_force_stop_package org.isomorphisms.ib

printf '%s\n' 'android Binder host boundary tests: ok'
